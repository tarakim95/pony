# Pony — Environment Variables
# 실제 값은 .env.local에 (절대 깃에 커밋하지 말 것)

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 서버 전용, 절대 클라이언트 노출 X

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Data Sources ===
NEWSAPI_KEY=your-newsapi-key
# RSS는 키 불필요

# === Cost Limits ===
LLM_DAILY_LIMIT_USD=1.00
LLM_MONTHLY_LIMIT_USD=30.00
LLM_DAILY_CALL_LIMIT=100

# === Environment ===
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development  # development | production

# === Cron Secret ===
# Vercel Cron이 호출할 때 검증용
CRON_SECRET=your-random-secret-here

ENGINE_TRIGGER_SECRET=
